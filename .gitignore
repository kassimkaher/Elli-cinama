/build.gradle
/settings.gradle
/gradle.properties
/.gradle/
/local.properties
*.iml
/.idea/
/.vscode/

# OS / editor cruft
.DS_Store
**/.DS_Store

# Never commit any local env/secret files
*.env
.env
**/last_run.sanitized.json

